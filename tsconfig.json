{
  "compilerOptions": {
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src/main/typescript",
    "outDir": "build/generated/frontend/assets/web",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/main/typescript/**/*.ts"]
}
